EASYFILE_TRANSPORT=stdio
EASYFILE_PORT=3000
EASYFILE_HOST=127.0.0.1
EASYFILE_DATA_DIR=.easyfile
# Required for HTTP transport outside local development.
EASYFILE_API_KEY=
# Comma-separated browser origins allowed to call the HTTP transport.
EASYFILE_ALLOWED_ORIGINS=
# Comma-separated valid Host header names; strongly recommended with a non-loopback bind.
EASYFILE_ALLOWED_HOSTS=
# Optional integration credentials. Keep secrets out of source control.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
BUSINESS_CENTRAL_TENANT_ID=
BUSINESS_CENTRAL_ENVIRONMENT=
BUSINESS_CENTRAL_COMPANY_ID=
BUSINESS_CENTRAL_ACCESS_TOKEN=
DYNAMICS_365_BASE_URL=
DYNAMICS_365_ACCESS_TOKEN=
SAGE_BASE_URL=
SAGE_ACCESS_TOKEN=
XERO_TENANT_ID=
XERO_ACCESS_TOKEN=
EASYFILE_WEBHOOK_URL=
EASYFILE_WEBHOOK_SECRET=
